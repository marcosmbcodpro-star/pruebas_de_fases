{
  "name": "mindplace-solo-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:phase14": "node --test tests/phase14-core.test.mjs",
    "test:browser": "node scripts/phase14-browser.mjs",
    "test:phase15": "node --test tests/phase15-final.test.mjs && node scripts/phase15-audit.mjs",
    "test:all": "npm test && npm run test:phase16 && npm run test:phase17 && npm run test:browser && npm run test:phase15",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:phase16": "node --test tests/phase16-architecture.test.mjs && node scripts/phase16-audit.mjs",
    "start": "vite",
    "audit:phase16": "node scripts/phase16-audit.mjs",
    "test:phase17": "node --test tests/phase17-mobile.test.mjs && node scripts/phase17-audit.mjs",
    "audit:phase17": "node scripts/phase17-audit.mjs"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "vitest": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.0"
  }
}
